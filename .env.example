# Copy this file to .env (which git ignores) to change how scripts/build.sh builds Nudge.

# Code signing identity. "-" signs ad-hoc, which works, but macOS then asks for
# Accessibility and Screen Recording again after every rebuild. A stable identity
# keeps those permissions. List yours with: security find-identity -v -p codesigning
NUDGE_SIGN_IDENTITY="-"

# Where the built app goes. Keep it in one place so macOS permissions stay attached.
NUDGE_APP_PATH="build/Nudge.app"

# release or debug
NUDGE_CONFIGURATION="release"
